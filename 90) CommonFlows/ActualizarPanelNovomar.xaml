  <Sequence DisplayName="Actualizar panel web de Novomar" sap:VirtualizedContainerService.HintSize="636,1180" sap2010:WorkflowViewState.IdRef="Sequence_PanelNovomar_1">
    <Sequence.Variables><Variable x:TypeArguments="x:String" Name="RutaJson_Str" /><Variable x:TypeArguments="x:String" Name="NombreSprint_Str" /><Variable x:TypeArguments="x:String" Name="FinalizarProceso_Str" /><Variable x:TypeArguments="x:String" Name="PasosTexto_Str" /><Variable x:TypeArguments="x:String" Name="DescripcionesTexto_Str" /><Variable x:TypeArguments="x:String" Name="MensajeError_Str" /><Variable x:TypeArguments="x:String" Name="PublicarCloudflare_Str" /><Variable x:TypeArguments="x:String" Name="CloudflareUrlBase_Str" /><Variable x:TypeArguments="x:String" Name="CloudflareApiToken_Str" /><Variable x:TypeArguments="x:Int32" Name="IndiceItemPanel_Int" /><Variable x:TypeArguments="x:Int32" Name="TotalItemsPanel_Int" /><Variable x:TypeArguments="x:String" Name="IdentificadorItemPanel_Str" /></Sequence.Variables>
    <Assign DisplayName="Configurar ruta JSON"><Assign.To><OutArgument x:TypeArguments="x:String">[RutaJson_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;RutaJasonRIBU22GMX02_EmitPolizaCasaHabNovomar&quot;), in_Config(&quot;RutaJasonRIBU22GMX02_EmitPolizaCasaHabNovomar&quot;).ToString, String.Empty)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar nombre del proceso"><Assign.To><OutArgument x:TypeArguments="x:String">[NombreSprint_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">RIBU22GMX02_EmitPolizaCasaHabNovomar</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar cierre"><Assign.To><OutArgument x:TypeArguments="x:String">[FinalizarProceso_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(i_finalizarProceso_Str, String.Empty)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar pasos"><Assign.To><OutArgument x:TypeArguments="x:String">[PasosTexto_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">Inicializar configuracion del robot||Preparar solicitudes y plantillas base||Leer correos de solicitud||Extraer datos del correo||Crear carpeta y guardar archivos de solicitud||Extraer datos del certificado PDF||Calcular cuotas y coberturas||Registrar datos en mapeo||Generar hoja contable y Slip||Registrar pagador y asegurado en SII||Preparar emision en SII||Capturar datos generales de poliza||Capturar riesgos y coberturas||Confirmar emision y recuperar poliza||Crear PDFs de traduccion||Iniciar expediente digital GEDI||Cargar documentos en GEDI||Confirmar expediente digital||Enviar reporte final||Finalizar proceso Novomar</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar descripciones"><Assign.To><OutArgument x:TypeArguments="x:String">[DescripcionesTexto_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">Lee Config.xlsx y configura las variables usadas por el panel.||Prepara el archivo del dia, catalogos, carpetas y plantillas del proceso.||Consulta Outlook y localiza las solicitudes de Novomar que deben procesarse.||Obtiene folio, suscriptor, tipo de movimiento y poliza anterior.||Crea la carpeta del folio, guarda adjuntos y copia los archivos base.||Lee el certificado y obtiene datos generales, vigencias, primas y especificaciones.||Consulta catalogos y calcula las cuotas hidrologicas cuando corresponde.||Escribe los datos normalizados y las coberturas en el archivo de mapeo.||Completa la hoja contable y prepara el documento Slip de la solicitud.||Da de alta o valida los datos del contratante y asegurado en SII.||Lee la solicitud actual, inicia sesion y abre el modulo de emision.||Captura movimiento, vigencia, contratante y datos generales de la poliza.||Registra riesgos, coberturas, sumas aseguradas, primas y condiciones.||Confirma la emision y recupera la poliza nueva y su sufijo.||Genera los archivos PDF requeridos para documentacion y traduccion.||Lee la poliza emitida e inicia la preparacion del expediente digital.||Adjunta condiciones, comprobantes y documentos requeridos de la solicitud.||Valida la carga, guarda el comprobante de GEDI y actualiza la solicitud.||Actualiza estatus, envia el correo de cierre y organiza los mensajes procesados.||Publica en el panel el cierre correcto o el error final del proceso.</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Leer indice dinamico de solicitud"><Assign.To><OutArgument x:TypeArguments="x:Int32">[IndiceItemPanel_Int]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[If(in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;PanelItemIndice&quot;), CInt(in_Config(&quot;PanelItemIndice&quot;)), 0)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Leer total dinamico de solicitudes"><Assign.To><OutArgument x:TypeArguments="x:Int32">[TotalItemsPanel_Int]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Int32">[If(in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;PanelItemTotal&quot;), CInt(in_Config(&quot;PanelItemTotal&quot;)), 0)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Leer identificador dinamico de solicitud"><Assign.To><OutArgument x:TypeArguments="x:String">[IdentificadorItemPanel_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;PanelItemIdentificador&quot;), in_Config(&quot;PanelItemIdentificador&quot;).ToString, String.Empty)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Agregar contexto dinamico a pasos"><Assign.To><OutArgument x:TypeArguments="x:String">[PasosTexto_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(IndiceItemPanel_Int &gt; 0 AndAlso TotalItemsPanel_Int &gt; 0, String.Join(&quot;||&quot;, PasosTexto_Str.Split(New String() {&quot;||&quot;}, StringSplitOptions.None).Select(Function(texto, indice) If(indice &gt;= 3 AndAlso indice &lt;= 17, texto + &quot; - Solicitud &quot; + IndiceItemPanel_Int.ToString + &quot; de &quot; + TotalItemsPanel_Int.ToString + If(String.IsNullOrWhiteSpace(IdentificadorItemPanel_Str), String.Empty, &quot; (&quot; + IdentificadorItemPanel_Str + &quot;)&quot;), texto))), PasosTexto_Str)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Agregar contexto dinamico a descripciones"><Assign.To><OutArgument x:TypeArguments="x:String">[DescripcionesTexto_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(IndiceItemPanel_Int &gt; 0 AndAlso TotalItemsPanel_Int &gt; 0, String.Join(&quot;||&quot;, DescripcionesTexto_Str.Split(New String() {&quot;||&quot;}, StringSplitOptions.None).Select(Function(texto, indice) If(indice &gt;= 3 AndAlso indice &lt;= 17, &quot;Solicitud &quot; + IndiceItemPanel_Int.ToString + &quot; de &quot; + TotalItemsPanel_Int.ToString + If(String.IsNullOrWhiteSpace(IdentificadorItemPanel_Str), String.Empty, &quot; (&quot; + IdentificadorItemPanel_Str + &quot;)&quot;) + &quot;: &quot; + texto, texto))), DescripcionesTexto_Str)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar mensaje de error"><Assign.To><OutArgument x:TypeArguments="x:String">[MensajeError_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(i_mensajeError_Str, String.Empty)]</InArgument></Assign.Value></Assign>
    <Assign DisplayName="Configurar publicacion"><Assign.To><OutArgument x:TypeArguments="x:String">[PublicarCloudflare_Str]</OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String">[If(in_Config IsNot Nothing AndAlso in_Config.ContainsKey(&quot;CloudflarePublicarPanelWeb&quot;), in_Config(&quot;CloudflarePublicarPanelWeb&quot;).ToString, &quot;False&quot;)]</InArgument></Assign.Value></Assign>
