    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="True" DisplayName="Ejecutar plantilla ActualizarPanelSprint" UnSafe="False" WorkflowFileName="90) CommonFlows\ActualizarPanelSprint.xaml"><ui:InvokeWorkflowFile.Arguments><InOutArgument x:TypeArguments="x:String" x:Key="io_rutaJson_Str">[RutaJson_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_nombreSprint_Str">[NombreSprint_Str]</InOutArgument><InArgument x:TypeArguments="x:String" x:Key="i_pasoActual_Str">[i_pasoActual_Str]</InArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_finalizarProceso_Str">[FinalizarProceso_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_pasosTexto_Str">[PasosTexto_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_descripcionesTexto_Str">[DescripcionesTexto_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_mensajeError_Str">[MensajeError_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_publicarCloudflare_Str">[PublicarCloudflare_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_cloudflareUrlBase_Str">[CloudflareUrlBase_Str]</InOutArgument><InOutArgument x:TypeArguments="x:String" x:Key="io_cloudflareApiToken_Str">[CloudflareApiToken_Str]</InOutArgument></ui:InvokeWorkflowFile.Arguments></ui:InvokeWorkflowFile>
